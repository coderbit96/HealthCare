# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/health-care

# Firebase Web SDK (public values from Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (keep server-only; use a JSON string or Base64 JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local development alternative only: absolute path to an uncommitted service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Admin seeding (used only by `npm run seed:admin`, never read by the app at runtime).
# Do NOT store a real password here — pass it inline when running the script:
#   ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='<strong password>' npm run seed:admin
# Omit ADMIN_PASSWORD to have a strong one generated and printed once.
ADMIN_EMAIL=
ADMIN_NAME=

# Development-only demo accounts (created by `npm run seed:demo`).
# Keep passwords only in .env.local; do not commit them.
DEMO_PASSWORD=
DEMO_DOCTOR_EMAIL=doctor@healthcare.demo
DEMO_NURSE_EMAIL=nurse@healthcare.demo
DEMO_RECEPTIONIST_EMAIL=reception@healthcare.demo
DEMO_HR_EMAIL=hr@healthcare.demo
DEMO_LAB_TECHNICIAN_EMAIL=lab@healthcare.demo
DEMO_PHARMACIST_EMAIL=pharmacy@healthcare.demo
DEMO_PATIENT_EMAIL=patient@healthcare.demo
